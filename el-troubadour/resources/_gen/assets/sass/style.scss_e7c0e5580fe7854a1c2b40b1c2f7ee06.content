@font-face{font-family:amatic sc;src:url(fonts/AmaticSC-Bold.woff2)format("woff2");font-weight:700;font-style:normal;font-display:swap}@font-face{font-family:amatic sc;src:url(fonts/AmaticSC-Regular.woff2)format("woff2");font-weight:400;font-style:normal;font-display:swap}@font-face{font-family:kreon;src:url(fonts/Kreon-Regular.woff2)format("woff2");font-weight:400;font-style:normal;font-display:swap}@font-face{font-family:kreon;src:url(fonts/Kreon-Bold.woff2)format("woff2");font-weight:700;font-style:normal;font-display:swap}*{box-sizing:border-box;transition:background-color .2s,filter .2s,transform .2s}body,html{width:100%;height:100%;padding:0;margin:0;font-family:kreon,Calibri,serif;font-weight:300;color:#232120}body{background-image:url(bg-pattern.webp);background-position-x:center;background-repeat:repeat}.block-centered{margin:auto;max-width:430px;padding-left:.5em;padding-right:.5em}.margin-none{margin:0}.text-color-white{color:#f3f3f3}.remove-list-styles{list-style-type:none;margin-left:0;padding-left:0}.bg-color-black{background-color:#232120}.font-header{font-family:amatic sc}.font-body{font-family:kreon}.min-width-m{min-width:200px}.width-max-s{max-width:175px}.width-max-l{max-width:500px}.height-xxs{height:50px}.height-s{height:200px}.height-sm{height:275px}.height-m{height:350px}.height-l{height:500px}.margin-bottom-negative-s{margin-bottom:-150px}.margin-bottom-negative-m{margin-bottom:-300px}img{max-width:100%}a{text-decoration:none;color:inherit}.margin-h-xs{margin-left:5px;margin-right:5px}.font-size-s{font-size:12px}.opacity-m{opacity:.5}.text-color-white{color:#fff}.border-radius-s{border-radius:5px}.block-center-h{margin:auto}.bg-image-header{background-image:url(header.webp);background-repeat:repeat-x;background-position-x:center}.bg-image-header-truncated{background-image:url(header-truncated.webp);background-repeat:repeat-x;background-position-x:center}.bg-image-footer{background-image:url(footer.webp);background-position-x:center}.display-flex{display:flex}.flex-wrap{flex-wrap:wrap}.margin-top-xs{margin-top:5px}.flex-center{justify-content:center;align-content:center;align-items:center}.flex-space-center{justify-content:space-between;align-content:center;align-items:center}.display-grid{display:grid}.grid-columns-two{grid-template-columns:auto auto}.grid-columns-two-flexible{grid-template-columns:repeat(auto-fill,minmax(220px,1fr))}.gap-xs{gap:5px}.gap-m{gap:15px}.gap-l{gap:20px}.bg-color-transparent{background-color:transparent}.inset-shadow-l{box-shadow:inset 0 0 50px #000}.main-content{padding-left:.5em;padding-right:.5em}.main-content>p:first-of-type{font-size:20px;font-weight:500}.remark{background-color:#ccc;border-radius:6px;padding:10px}.example{background-color:#999;border-radius:6px;padding:10px}.text-center{text-align:center}.color-copy{color:inherit}.text-decoration-none{text-decoration:none}.width-maximize{width:100%}@media all and (max-width:500px){.width-maximize-phone{width:100%}}.padding-m{padding:10px}.border-radius-m{border-radius:10px}.cursor-pointer{cursor:pointer}.font-weight-bold{font-weight:900}.font-size-l{font-size:200%}.position-relative{position:relative}.text-decoration-underline{text-decoration-line:underline;text-decoration-thickness:2px;text-decoration-style:solid}.brighten_hover:hover{filter:drop-shadow(0 2px 2px black)brightness(120%)}.text-decoration-underline_hover:hover{text-decoration-line:underline;text-decoration-thickness:2px;text-decoration-style:solid}.popup_hover:hover{transform:scale(1.25)}h1,h2,h3,h4,h5,h6{font-family:amatic sc,Arial,cursive;margin:0;padding:0}.main-content h2,.main-content h3{background-image:url(sheet-music.webp);background-repeat:no-repeat;background-size:680px 54px;min-height:50px;padding-bottom:0;padding-left:37px;padding-right:37px;padding-top:8px;margin-top:25px;margin-bottom:-13px;margin-left:-35px;margin-right:-35px;font-size:30px}@media all and (max-width:500px){h1{font-size:16px}}.main-content h1{max-width:350px;margin:auto;text-align:center;margin-top:50px;font-size:42px}.main-content h3{font-size:24px;padding-top:14px;padding-left:60px}.summary-type-misc{background-color:oklch(.8 .1 80)}.summary-type-misc:hover{background-color:oklch(.8 .1 20)}.summary-type-tab{background-color:oklch(.8 .1 150)}.summary-type-tab:hover{background-color:oklch(.8 .1 180)}.icon{display:inline-block;width:30px;height:30px;background-image:url(icons.webp);background-size:400%}.icon-home{background-position-x:0}.icon-albums{background-position-x:-30px}.icon-blog{background-position-x:-60px}.icon-about{background-position-x:-90px}.link-colored{background-color:#fff;border-radius:5px;text-decoration:none;color:#232120;display:inline-block}.link-colored:hover{filter:drop-shadow(0 2px 2px #232120)}.link-red,.tag-red{background-color:oklch(.8 .1 0)}.link-orange,.tag-orange{background-color:oklch(.8 .1 40)}.link-yellow,.tag-yellow{background-color:oklch(.8 .1 80)}.link-lime,.tag-lime{background-color:oklch(.8 .1 120)}.link-turquoise,.tag-turquoise{background-color:oklch(.8 .1 160)}.link-cyan,.tag-cyan{background-color:oklch(.8 .1 200)}.link-blue,.tag-blue{background-color:oklch(.8 .1 240)}.link-purple,.tag-purple{background-color:oklch(.8 .1 280)}.link-pink,.tag-pink{background-color:oklch(.8 .1 320)}.tag{padding-left:5px;padding-right:5px;border-radius:3px;text-decoration:none !important;white-space:nowrap}.tag:hover{filter:drop-shadow(0 2px 2px black)}.tag-neutral,.tag-date{background-color:#232120;color:#f3f3f3}.album-link{display:block;width:60px;height:60px;background-image:url(music-platform-icons.webp);background-size:800%;margin-top:20px}.album-link:hover{transform:scale(1.2);filter:drop-shadow(0 2px 2px #321)}.album-link-spotify{background-position-x:0}.album-link-itunes{background-position-x:-60px}.album-link-youtube{background-position-x:-120px}.album-link-amazon{background-position-x:-180px}.album-link-deezer{background-position-x:-240px}.album-link-webshop{background-position-x:-300px}.album-link-bandcamp{background-position-x:-360px}